{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Workers config name; Pages deploy uses --project-name astrabound (must match Dashboard).
  // Production site: https://astra.jakesarcade.app/ (Pages project: astrabound)
  "name": "astrabound",
  "compatibility_date": "2026-05-01",
  "pages_build_output_dir": ".",
  "ai": {
    "binding": "AI"
  }
}
